{
  "name": "onmatout_rn",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "NODE_ENV=development expo start --clear",
    "start:prod": "NODE_ENV=production expo start --clear",
    "ios": "expo run:ios",
    "ios:dev": "NODE_ENV=development expo run:ios",
    "ios:prod": "NODE_ENV=production expo run:ios",
    "android": "expo run:android",
    "android:dev": "NODE_ENV=development expo run:android",
    "android:prod": "NODE_ENV=production expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:ios:dev": "eas build --platform ios --profile production-dev",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:ios:preview:dev": "eas build --platform ios --profile preview-dev",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:dev": "eas build --platform android --profile production-dev",
    "build:android:prod": "eas build --platform android --profile production",
    "build:android:preview:dev": "eas build --platform android --profile preview-dev",
    "build:android:preview": "eas build --platform android --profile preview",
    "submit:ios:dev": "eas submit --platform ios --profile production-dev --latest",
    "submit:ios:prod": "eas submit --platform ios --profile production --latest",
    "submit:android:dev": "eas submit --platform android --profile production-dev --latest",
    "submit:android:prod": "eas submit --platform android --profile production --latest",
    "update:prod": "eas update --channel production --message",
    "update:preview": "eas update --channel preview --message",
    "bump:ios": "eas build:version --platform ios",
    "bump:android": "eas build:version --platform android",
    "bump:all": "eas build:version --platform all",
    "device:add": "eas device:create",
    "prebuild": "expo prebuild --clean",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:pods": "npx pod-install",
    "ios:open": "open ios/*.xcworkspace",
    "build:android:local": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:bundle": "cd android && ./gradlew bundleRelease && cd ..",
    "android:install:release": "cd android && ./gradlew assembleRelease && cd .. && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "install:android:release": "npm run android:install:release",
    "reset-project": "node ./scripts/reset-project.js",
    "gen:asana-images": "node scripts/gen-asana-images.js"
  },
