{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium",
        "autoIncrement": true,
        "cache": {
          "disabled": true
        }
      },
      "android": {
        "resourceClass": "medium",
        "autoIncrement": true
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_USE_HERMES": "true"
      }
    },
    "testflight": {
      "extends": "production",
      "channel": "production",
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_USE_HERMES": "true"
      }
    },
    "development-dev": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_CONFIG": "development"
      }
    },
    "preview-dev": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_CONFIG": "development"
      }
    },
    "production-dev": {
      "extends": "base",
      "env": {
        "APP_CONFIG": "development"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "junseopsan@gmail.com",
        "ascAppId": "6746711838",
        "appleTeamId": "JG26695UN3"
      }
    },
    "production-dev": {
      "ios": {
        "appleId": "junseopsan@gmail.com",
        "ascAppId": "6749815418",
        "appleTeamId": "JG26695UN3"
      }
    }
  }
}
